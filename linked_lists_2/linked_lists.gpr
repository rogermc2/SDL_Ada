
with "config/linked_lists_config.gpr";
project Linked_Lists is

   for Source_Dirs use ("src", "config", "src/data_types");
   for Object_Dir use "obj/" & Linked_Lists_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use ".";
   for Main use ("linked.adb");

   package Compiler is
      for Default_Switches ("Ada") use Linked_Lists_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Switches ("ada") use ("-lSDL2");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Linked_Lists;

