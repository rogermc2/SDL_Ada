
with "config/arrays_config.gpr";
project Arrays is

   for Source_Dirs use ("src", "config", "src/data_types");
   for Object_Dir use "obj/" & Arrays_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use ".";
   for Main use ("manage_arrays.adb");

   package Compiler is
      for Default_Switches ("Ada") use  ("-gnat2022") & Arrays_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Switches ("ada") use ("-lSDL2");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Arrays;

